# 微光 · 环境变量示例（复制为 .env 后填入真实值；.env 不进代码仓库）
# 本文件只含【密钥与基础设施连接】。
# AI 与存储的非密钥运行参数（模型名/超时/重试/存储目录/图片上限等）以管理端配置页（sys_config）为准，不在本文件；
# 密钥永不入 sys_config。

# —— 阿里云百炼（DashScope）——
DASHSCOPE_API_KEY=

# —— MySQL ——
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=weiguang
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# —— Redis ——
REDIS_HOST=localhost
REDIS_PORT=6379

# —— 微信小程序 ——
WECHAT_APPID=
WECHAT_APP_SECRET=

# —— 鉴权 ——
JWT_SECRET=

# —— 服务 ——
SERVER_PORT=8080

# —— 管理端初始账号（seed）——
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=
